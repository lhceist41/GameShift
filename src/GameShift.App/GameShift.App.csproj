<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameShift.Core\GameShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.0.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\tray-idle.ico" />
    <Resource Include="Assets\Icons\tray-active.ico" />
    <Resource Include="Assets\Icons\tray-warning.ico" />
    <Resource Include="Assets\Icons\tray-error.ico" />
    <Resource Include="Resources\gameshift.ico" />
    <Resource Include="Resources\gameshift-256.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>GameShift.App.Program</StartupObject>

    <!-- Application icon (shown in Explorer and taskbar) -->
    <ApplicationIcon>Assets\Icons\app-icon.ico</ApplicationIcon>

    <!-- Assembly metadata (shown in exe file properties) -->
    <AssemblyTitle>GameShift</AssemblyTitle>
    <Product>GameShift</Product>
    <Description>Automatic gaming performance optimizer for Windows</Description>
    <Company>GameShift</Company>
    <Copyright>Copyright (c) 2026 GameShift Contributors. MIT License.</Copyright>
    <Version>3.8.1</Version>
    <AssemblyVersion>3.8.1.0</AssemblyVersion>
    <FileVersion>3.8.1.0</FileVersion>

    <!-- Publish configuration for single-file self-contained exe -->
    <!-- RuntimeIdentifier is NOT set here to avoid changing debug output paths. -->
    <!-- Pass -r win-x64 to dotnet publish instead. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ReadyToRun pre-compiles IL to native code so the app starts without JIT-ing on the hot path.
         crossgen2 runs in composite mode here (single-file + self-contained). Microsoft.Diagnostics.Tracing.TraceEvent
         lists two of its managed COM-interop assemblies (Dia2Lib.dll, TraceReloggerLib.dll) in the publish
         set twice, which makes crossgen2 abort with NETSDK1096 "Multiple input files matching same simple
         name". PublishReadyToRunExclude can't fix it - the duplicate is a compiler *input*, gathered before
         per-assembly exclusion. The _DeduplicateResolvedFileToPublish target below drops the exact-duplicate
         entries before R2R runs; the rest of the app is R2R-compiled normally. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Compression shrinks the download but forces the entire self-contained bundle to be
         decompressed to a temp directory on every cold start, adding seconds to first launch.
         For a performance tool, a fast start matters more than a smaller download. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Microsoft.Diagnostics.Tracing.TraceEvent (the DPC-latency ETW tracing in GameShift.Core/Monitoring)
       adds four of its assemblies to the publish set twice with an identical source path and destination:
       the managed COM-interop shims Dia2Lib.dll and TraceReloggerLib.dll (R2R-compiled), plus the native
       KernelTraceControl.dll and msdia140.dll. In composite ReadyToRun mode crossgen2 sees the two managed
       duplicates as inputs with the same simple name and aborts with NETSDK1096. Collapse the redundant
       entries before R2R compilation gathers its inputs. Each duplicate is byte-identical with the same
       RelativePath, so removing the extra copy leaves the published output unchanged. This target only runs
       during a ReadyToRun publish (_PrepareForReadyToRunCompilation is reached only when PublishReadyToRun
       is true), so normal builds and tests are unaffected. -->
  <Target Name="_DeduplicateResolvedFileToPublish" BeforeTargets="_PrepareForReadyToRunCompilation">
    <RemoveDuplicates Inputs="@(ResolvedFileToPublish)">
      <Output TaskParameter="Filtered" ItemName="_DedupedResolvedFileToPublish" />
    </RemoveDuplicates>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_DedupedResolvedFileToPublish)" />
    </ItemGroup>
  </Target>

</Project>

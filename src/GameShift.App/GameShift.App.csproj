<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameShift.Core\GameShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.0.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\tray-idle.ico" />
    <Resource Include="Assets\Icons\tray-active.ico" />
    <Resource Include="Assets\Icons\tray-warning.ico" />
    <Resource Include="Assets\Icons\tray-error.ico" />
    <Resource Include="Resources\gameshift.ico" />
    <Resource Include="Resources\gameshift-256.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>GameShift.App.Program</StartupObject>

    <!-- Application icon (shown in Explorer and taskbar) -->
    <ApplicationIcon>Assets\Icons\app-icon.ico</ApplicationIcon>

    <!-- Assembly metadata (shown in exe file properties) -->
    <AssemblyTitle>GameShift</AssemblyTitle>
    <Product>GameShift</Product>
    <Description>Automatic gaming performance optimizer for Windows</Description>
    <Company>GameShift</Company>
    <Copyright>Copyright (c) 2026 GameShift Contributors. MIT License.</Copyright>
    <Version>3.8.0</Version>
    <AssemblyVersion>3.8.0.0</AssemblyVersion>
    <FileVersion>3.8.0.0</FileVersion>

    <!-- Publish configuration for single-file self-contained exe -->
    <!-- RuntimeIdentifier is NOT set here to avoid changing debug output paths. -->
    <!-- Pass -r win-x64 to dotnet publish instead. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ReadyToRun is disabled: Microsoft.Diagnostics.Tracing.TraceEvent ships Dia2Lib.dll in a way
         that breaks crossgen2 (NETSDK1096 "Multiple input files matching same simple name"), which
         fails `dotnet publish -r win-x64`. PublishReadyToRunExclude doesn't help (the failure is a
         duplicate compiler input, before per-assembly exclusion). Single-file + no-compression below
         still avoid the temp-unpack cold-start cost. Re-enable once the TraceEvent duplicate is fixed. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Compression shrinks the download but forces the entire self-contained bundle to be
         decompressed to a temp directory on every cold start, adding seconds to first launch.
         For a performance tool, a fast start matters more than a smaller download. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>

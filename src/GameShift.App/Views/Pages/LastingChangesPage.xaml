<Page x:Class="GameShift.App.Views.Pages.LastingChangesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GameShift.App.Helpers"
      FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- The restart tag: warning-coloured text with a power icon -->
        <DataTemplate x:Key="RestartTag">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:SymbolIcon Symbol="Power24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource GS.State.Warning}"/>
                <TextBlock Text="Restart needed" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource GS.State.Warning}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  helpers:ScrollHelper.FixScrolling="True">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" DockPanel.Dock="Right"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource GS.Fg.Secondary}"/>
                <TextBlock Text="Lasting changes" Style="{DynamicResource GS.Text.Hero}" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="Changes to Windows that stay after a game exits and after GameShift closes. Restore All undoes every lasting change GameShift recorded, including tweaks that earlier versions offered, and asks separately about changes it cannot tell it made."
                       FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Found on this PC, with Restore All -->
            <TextBlock Text="FOUND ON THIS PC" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GS.Row}">
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="Warning16" FontSize="14" Margin="0,0,8,0"
                                                       DockPanel.Dock="Left" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GS.State.Warning}"/>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource GS.Row}"
                            Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Looking for lasting changes..." Style="{StaticResource RowText}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GS.Row}"
                            Visibility="{Binding NoChangesFound, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="GameShift found no lasting changes on this PC." Style="{StaticResource RowText}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GS.Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding UndoDescription}" Style="{StaticResource RowText}"/>
                                        <TextBlock Text="GameShift did not record this change, so Restore All asks before undoing it."
                                                   Style="{StaticResource RowText}"
                                                   Visibility="{Binding NeedsOwnConfirmation, Converter={StaticResource BoolToVisibility}}"/>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RestartTag}" Focusable="False"
                                                        Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                        <Button x:Name="RestoreAllButton" Content="Restore All GameShift Tweaks"
                                Style="{StaticResource GS.Button.Primary}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="OnRestoreAllClicked"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tweaks GameShift offers -->
            <TextBlock Text="SYSTEM TWEAKS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding Tweaks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GS.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource RowText}"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource RowText}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RestartTag}" Focusable="False"
                                                        Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="{Binding ButtonText}" Tag="{Binding Tweak}"
                                                IsEnabled="{Binding ButtonEnabled}"
                                                Style="{StaticResource GS.Button.Restart}"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnTweakButtonClicked"/>
                                        <Button Content="{Binding ButtonText}" Tag="{Binding Tweak}"
                                                IsEnabled="{Binding ButtonEnabled}"
                                                Style="{StaticResource GS.Button.Primary}"
                                                Visibility="{Binding NoReboot, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnTweakButtonClicked"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Latency Doctor keeps its own fixes -->
            <TextBlock Text="LATENCY DOCTOR FIXES" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0">
                <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Latency Doctor fixes" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="The fixes Latency Doctor applies are lasting changes too. Turn them on or off there; Restore All above also undoes them."
                                       Style="{StaticResource RowText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Latency Doctor" VerticalAlignment="Center"
                                Click="OnOpenLatencyDoctorClicked"/>
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

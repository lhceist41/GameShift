<Page x:Class="GameShift.App.Views.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GameShift.App.Helpers"
      FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- A module switch row; changes wait for Save, so the control is a check box, not a switch -->
        <DataTemplate x:Key="ModuleRow">
            <Border Style="{StaticResource GS.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Effect}" Style="{StaticResource RowText}"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource RowText}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding ModuleName}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource GS.Fg.Tertiary}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" MinWidth="76" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{Binding Title}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="280"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Profiles" Style="{DynamicResource GS.Text.Hero}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Choose what GameShift changes for each game. A game without its own profile uses the default profile. Changes take effect when you save them."
                       FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Games and the default profile -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock Text="GAMES" Style="{StaticResource GS.Text.Caps}" DockPanel.Dock="Top" Margin="12,12,12,8"/>
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Foreground="{DynamicResource GS.Fg.Primary}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource GS.Fg.Primary}"/>
                                <TextBlock Text="{Binding Source}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource GS.Fg.Secondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The selected profile -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="Save" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Style="{StaticResource GS.Button.Primary}"
                        IsEnabled="{Binding IsDirty, Mode=OneWay}"
                        Click="OnSaveClicked"/>
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource GS.Fg.Secondary}"/>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          helpers:ScrollHelper.FixScrolling="True">
                <StackPanel IsEnabled="{Binding HasSelectedProfile, Mode=OneWay}">

                    <TextBlock Text="DURING GAMES" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                        <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource ModuleRow}" Focusable="False"/>
                    </Border>

                    <TextBlock Text="ADVANCED" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                        <ItemsControl ItemsSource="{Binding AdvancedModules}" ItemTemplate="{StaticResource ModuleRow}" Focusable="False"/>
                    </Border>

                    <TextBlock Text="MONITORING" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                        <StackPanel>
                            <Border Style="{StaticResource GS.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Watch DPC load" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Watches DPC load while you play and alerts on spikes."
                                                   Style="{StaticResource RowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" MinWidth="76" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding EnableDpcMonitoring, Mode=TwoWay}" HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Watch DPC load"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DPC load alert (% of CPU time)" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="For this game only. 0 uses the setting in Settings."
                                               Style="{StaticResource RowText}" Margin="0,2,0,6"/>
                                    <TextBox Text="{Binding DpcThresholdPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="100" HorizontalAlignment="Left"
                                             AutomationProperties.Name="DPC load alert (% of CPU time)"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Built-in knowledge for preset games -->
                    <TextBlock Text="GAME TIPS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"
                               Visibility="{Binding IsPresetGame, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24"
                            Visibility="{Binding IsPresetGame, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Style="{StaticResource GS.Row}"
                                    Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Shield16" FontSize="14" Margin="0,0,8,0"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GS.State.Warning}"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GS.Fg.Primary}">
                                        <Run Text="Anti-cheat:"/>
                                        <Run Text="{Binding AntiCheatBadge, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource GS.Row}" Background="{DynamicResource GS.Tint.Error}"
                                    Visibility="{Binding VbsSafetyActive, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Warning16" FontSize="14" Margin="0,0,8,0"
                                                   DockPanel.Dock="Left" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource GS.State.Error}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Keep Windows VBS on for this game" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource GS.State.Error}"/>
                                        <TextBlock Text="{Binding VbsSafetyReason}" Style="{StaticResource RowText}"
                                                   Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding GameActions}" Focusable="False"
                                          Visibility="{Binding HasGameActions, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GS.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource GS.Fg.Primary}"/>
                                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource RowText}"/>
                                                    <TextBlock Text="{Binding Condition}" Style="{StaticResource RowText}" FontStyle="Italic"
                                                               Visibility="{Binding IsConditional, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="Does not match this PC's hardware." Style="{StaticResource RowText}"
                                                               Visibility="{Binding IsHardwareMismatch, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource GS.Badge.State}">
                                                    <TextBlock Text="{Binding TierLabel}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource GS.Fg.Primary}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Per-game statistics from session history -->
                    <TextBlock Text="STATISTICS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"
                               Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Style="{StaticResource GS.Panel}" Padding="0"
                            Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Style="{StaticResource GS.Row}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalPlayTime}" DockPanel.Dock="Right" Margin="12,0,0,0"
                                               FontWeight="SemiBold" Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    <TextBlock Text="Total play time" TextWrapping="Wrap" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource GS.Row}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SessionCount}" DockPanel.Dock="Right" Margin="12,0,0,0"
                                               FontWeight="SemiBold" Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    <TextBlock Text="Sessions" TextWrapping="Wrap" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource GS.Row}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvgDpcLatency}" DockPanel.Dock="Right" Margin="12,0,0,0"
                                               FontWeight="SemiBold" Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    <TextBlock Text="Average DPC load" TextWrapping="Wrap" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BestDpcLatency}" DockPanel.Dock="Right" Margin="12,0,0,0"
                                               FontWeight="SemiBold" Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    <TextBlock Text="Lowest DPC load in a session" TextWrapping="Wrap" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Page>

<Page x:Class="GameShift.App.Views.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GameShift.App.Helpers"
      FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Windows feature state: GameShift only reads it, so it is a neutral badge, not a state colour -->
        <Style x:Key="FeatureWord" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A hardware advice line: warning tint and icon, the text itself stays in the text colour -->
        <Style x:Key="GraphicsAdvisory" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GS.Tint.Warning}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GS.Line.Badge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="GraphicsAdvisoryIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  helpers:ScrollHelper.FixScrolling="True">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,8">
                <Button Content="Refresh" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                        Style="{StaticResource GS.Button.Primary}"
                        Click="OnRefreshClicked"/>
                <TextBlock Text="System" Style="{DynamicResource GS.Text.Hero}" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="What Windows reports about this PC. This page only reads these values."
                       FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Hardware -->
            <TextBlock Text="HARDWARE" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Border Style="{StaticResource GS.Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Operating system" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OsCaption}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding OsVersion}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GS.Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Processor" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuName}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding CpuDetails}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GS.Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Graphics" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding GpuDetails}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GS.Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Memory" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RamTotal}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding RamDetails}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GS.Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Storage" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding StorageDetails}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Display" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayResolution}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="{Binding DisplayDetails}" Style="{StaticResource RowText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Windows gaming features -->
            <TextBlock Text="WINDOWS GAMING FEATURES" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <StackPanel>
                    <Border Style="{StaticResource GS.Row}">
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Right" Style="{StaticResource GS.Badge.State}" Margin="12,0,0,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FeatureWord}">
                                            <Setter Property="Text" Value="Off"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameModeEnabled}" Value="True">
                                                    <Setter Property="Text" Value="On"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Game Mode" Style="{StaticResource RowValue}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Right" Style="{StaticResource GS.Badge.State}" Margin="12,0,0,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FeatureWord}">
                                            <Setter Property="Text" Value="Off"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameBarEnabled}" Value="True">
                                                    <Setter Property="Text" Value="On"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Game Bar" Style="{StaticResource RowValue}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Graphics features: read from the hardware scan when GameShift started -->
            <TextBlock Text="GRAPHICS FEATURES" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <StackPanel>
                    <Border Style="{StaticResource GS.Row}">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource GS.Badge.State}" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding HagsStatus}" Style="{StaticResource FeatureWord}"/>
                                </Border>
                                <TextBlock Text="Hardware Accelerated GPU Scheduling (HAGS)" Style="{StaticResource RowValue}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource GraphicsAdvisory}"
                                    Visibility="{Binding ShowHagsAdvisory, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Warning16" Style="{StaticResource GraphicsAdvisoryIcon}"/>
                                    <TextBlock Text="{Binding HagsAdvisory}" Style="{StaticResource RowText}" Margin="0"
                                               Foreground="{DynamicResource GS.Fg.Primary}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GS.Row}" BorderThickness="0">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource GS.Badge.State}" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ReBarStatus}" Style="{StaticResource FeatureWord}"/>
                                </Border>
                                <TextBlock Text="Resizable BAR / Smart Access Memory" Style="{StaticResource RowValue}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource GraphicsAdvisory}"
                                    Visibility="{Binding ShowReBarAdvisory, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Warning16" Style="{StaticResource GraphicsAdvisoryIcon}"/>
                                    <TextBlock Text="{Binding ReBarAdvisory}" Style="{StaticResource RowText}" Margin="0"
                                               Foreground="{DynamicResource GS.Fg.Primary}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Top processes -->
            <TextBlock Text="TOP PROCESSES BY CPU TIME" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GS.Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowValue}"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource RowText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Startup apps: read only -->
            <TextBlock Text="STARTUP APPS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,4"/>
            <TextBlock Text="GameShift lists these and changes none of them. Turn startup apps on or off in Windows Settings &gt; Apps &gt; Startup."
                       FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0">
                <ItemsControl ItemsSource="{Binding StartupApps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GS.Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowValue}"/>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource RowText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

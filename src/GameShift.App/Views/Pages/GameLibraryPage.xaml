<Page x:Class="GameShift.App.Views.Pages.GameLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + buttons -->
            <RowDefinition Height="*"/>     <!-- Game list -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Add Game..." Style="{StaticResource GS.Button.Primary}"
                            Click="OnAddGameClicked" Margin="0,0,8,0"/>
                    <Button Content="Remove" MinHeight="32"
                            IsEnabled="{Binding CanRemove, Mode=OneWay}"
                            Click="OnRemoveGameClicked"/>
                </StackPanel>
                <TextBlock Text="Game Library" Style="{DynamicResource GS.Text.Hero}" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="Games GameShift found on this PC or that you added. GameShift starts its changes when one of them runs."
                       FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GS.Panel}" Padding="0">
            <Grid>
                <ListView ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GS.Fill.CardSecondary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GS.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource GS.Fg.Primary}"/>
                                        <TextBlock Text="{Binding DisplayPath}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource GS.Badge.State}">
                                        <TextBlock Text="{Binding LauncherSource}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource GS.Fg.Primary}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="No games found yet. Click Add Game to add one."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="16"
                           FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}"
                           Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Page>

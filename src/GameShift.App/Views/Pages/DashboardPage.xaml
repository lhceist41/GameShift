<Page x:Class="GameShift.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GameShift.App.Helpers"
      xmlns:controls="clr-namespace:GameShift.App.Views.Controls"
      xmlns:presentation="clr-namespace:GameShift.Core.Presentation;assembly=GameShift.Core"
      FontFamily="Segoe UI" FontSize="13">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A live tile's value and the line under it: a number large with its unit small, a word
             ("Measuring", "not available") smaller. The tone shows as the tag beside the label. -->
        <DataTemplate x:Key="LiveTileReading" DataType="{x:Type presentation:TileReading}">
            <StackPanel Margin="0,4,0,0">
                <TextBlock x:Name="NumberText" Style="{StaticResource GS.Counter}" FontSize="26" TextWrapping="Wrap">
                    <Run Text="{Binding Number, Mode=OneWay}"/><Run Text=" " FontSize="13"/><Run
                        Text="{Binding Unit, Mode=OneWay}" FontSize="13" FontWeight="Normal"
                        Foreground="{DynamicResource GS.Fg.Secondary}"/>
                </TextBlock>
                <TextBlock x:Name="WordText" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap"
                           Margin="0,6,0,4" Visibility="Collapsed"/>
                <TextBlock x:Name="TileDetail" Text="{Binding Detail}" FontSize="12"
                           Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasUnit}" Value="False">
                    <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="WordText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Detail}" Value="">
                    <Setter TargetName="TileDetail" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The tag beside a tile's label: Raised and High carry an icon and a word, not only a colour -->
        <DataTemplate x:Key="LiveTileTag" DataType="{x:Type presentation:TileReading}">
            <StackPanel x:Name="Tag" Orientation="Horizontal" Visibility="Collapsed">
                <ui:SymbolIcon x:Name="TagIcon" Symbol="Warning16" FontSize="12" Margin="0,0,4,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource GS.State.Warning}"/>
                <TextBlock x:Name="TagWord" Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource GS.State.Warning}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Raised">
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="High">
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TagIcon" Property="Symbol" Value="ErrorCircle16"/>
                    <Setter TargetName="TagIcon" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                    <Setter TargetName="TagWord" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A card's header row on Home's bottom panels -->
        <Style x:Key="HomeCardHeader" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GS.Line.Hairline}"/>
        </Style>

        <!-- Status strip (HomeStrip). Border, chip tint and chip colour follow the state: idle and an
             optimizing session without changes active stay neutral; the chip's word always says it. -->
        <Style x:Key="HomeStripPanel" TargetType="Border" BasedOn="{StaticResource GS.Panel}">
            <Setter Property="Padding" Value="16,14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Active">
                    <Setter Property="BorderBrush" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Kind}" Value="Paused">
                    <Setter Property="BorderBrush" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChip" TargetType="Border" BasedOn="{StaticResource GS.Badge.State}">
            <Setter Property="Padding" Value="8,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Kind}" Value="Paused">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChipIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Symbol" Value="Circle16"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Strip.Kind}" Value="Optimizing">
                    <Setter Property="Symbol" Value="Flash16"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Active">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Warning">
                    <Setter Property="Symbol" Value="Warning16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Kind}" Value="Paused">
                    <Setter Property="Symbol" Value="Pause16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeChipWord" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Active">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Tone}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Strip.Kind}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Module state icon and word, as on During games: colour follows the ModuleStatus kind -->
        <Style x:Key="ModuleBadgeIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Symbol" Value="Circle16"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Applied">
                    <Setter Property="Symbol" Value="CheckmarkCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Symbol" Value="ErrorCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Off">
                    <Setter Property="Symbol" Value="SubtractCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Off}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="NotAvailable">
                    <Setter Property="Symbol" Value="Prohibited16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Off}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter Property="Symbol" Value="Pause16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Off and Not available keep the Idle word colour: GS.State.Off is under 4.5:1 on the tint in Dark -->
        <Style x:Key="ModuleBadgeWord" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Applied">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Strip counters, after ModuleBadgeIcon, which they extend: applied and failed take their
             state colour only above 0 (HomeCounter.Highlight) -->
        <Style x:Key="HomeCounterIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource ModuleBadgeIcon}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeCounterValue" TargetType="TextBlock" BasedOn="{StaticResource GS.Counter}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Highlight}" Value="True"/>
                        <Condition Binding="{Binding StatusKind}" Value="Applied"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Highlight}" Value="True"/>
                        <Condition Binding="{Binding StatusKind}" Value="Failed"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- This session rows: a 14 px state icon and the state word in upper case, after the badge styles they extend -->
        <Style x:Key="SessionRowIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource ModuleBadgeIcon}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SessionRowWord" TargetType="TextBlock" BasedOn="{StaticResource ModuleBadgeWord}">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  helpers:ScrollHelper.FixScrolling="True">
        <StackPanel Margin="24">

            <!-- Status strip: what GameShift is doing now, from the same read as This session (HomeSnapshot).
                 First on Home, above the notices, so the state and the primary action stay in view. -->
            <Border Style="{StaticResource HomeStripPanel}" Margin="0,0,0,16"
                    AutomationProperties.Name="{Binding HomeStatus.Headline}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                        <Border Style="{StaticResource HomeChip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource HomeChipIcon}"/>
                                <TextBlock Text="{Binding Strip.Chip}" Style="{StaticResource HomeChipWord}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Strip.Title}" FontFamily="Bahnschrift, Segoe UI" FontSize="26"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource GS.Fg.Primary}"/>
                        <!-- Tabular figures keep the elapsed time from jittering as it counts -->
                        <TextBlock Text="{Binding Strip.SubLine}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource GS.Fg.Secondary}"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                        <!-- Busy: disabled, and the text says what it is doing -->
                        <Button Command="{Binding Hero.OptimizeNowCommand}"
                                IsEnabled="{Binding Hero.CanPressButton}"
                                MinWidth="140" Margin="0,0,0,8"
                                Style="{StaticResource GS.Button.Primary}">
                            <TextBlock Text="{Binding Hero.HeroButtonText}" TextWrapping="Wrap"/>
                        </Button>
                        <!-- The tray's own pause toggle, so Home, the tray menu and the hotkey share one path -->
                        <Button Margin="8,0,0,8" Click="OnPauseClicked"
                                IsEnabled="{Binding CanTogglePause}"
                                ToolTip="{Binding PauseButton.ToolTip}"
                                AutomationProperties.HelpText="{Binding PauseButton.ToolTip}"
                                Visibility="{Binding ShowPauseButton, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource GS.Button.Outline}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Pause16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Strip.Kind}" Value="Paused">
                                                    <Setter Property="Symbol" Value="Play16"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="{Binding PauseButton.Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Strip.Counters}"
                                  Margin="0,12,0,0" Focusable="False" IsTabStop="False"
                                  Visibility="{Binding HasCounters, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type presentation:HomeCounter}">
                                <StackPanel Margin="0,0,24,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Style="{StaticResource HomeCounterIcon}"/>
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource HomeCounterValue}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource GS.Fg.Secondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <!-- What Quick Optimize applies: a link that opens the list -->
                        <TextBlock x:Name="OptimizationPreviewLink"
                                   Text="{Binding Hero.HeroPreviewText}"
                                   FontSize="12" Cursor="Hand" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GS.Fg.Link}"
                                   Margin="0,8,0,0"
                                   MouseLeftButtonUp="OnOptimizationPreviewClicked"
                                   Visibility="{Binding Hero.ShowHeroPreview, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.TextDecorations>
                                <TextDecorationCollection>
                                    <TextDecoration Location="Underline"/>
                                </TextDecorationCollection>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                        <ItemsControl x:Name="PreviewList"
                                      ItemsSource="{Binding Hero.HeroPreviewItems}"
                                      Margin="0,6,0,0" Focusable="False"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource GS.Fg.Secondary}"
                                               Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Live tiles: only what GameShift measures; a source it cannot read says so (LiveTiles).
                 The feed stops while Home is not seen (HomeFeedGate). -->
            <UniformGrid x:Name="LiveTilePanel" Columns="4" Margin="-4,0,-4,4" SizeChanged="OnLiveTilesSizeChanged">

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Dpc.Reading}" Margin="8,0,0,0"
                                            ContentTemplate="{StaticResource LiveTileTag}" Focusable="False" IsTabStop="False"/>
                            <TextBlock Text="DPC LOAD" Style="{StaticResource GS.Text.Caps}"
                                       ToolTip="Share of CPU time drivers spend on deferred procedure calls (DPC). Lower is better."/>
                        </DockPanel>
                        <ContentControl Content="{Binding Dpc.Reading}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <controls:Sparkline Buffer="{Binding Dpc.History}" Height="28" Margin="0,6,0,0"
                                            Maximum="{x:Static presentation:LiveTiles.DpcHighAbove}"
                                            Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Ping.Reading}" Margin="8,0,0,0"
                                            ContentTemplate="{StaticResource LiveTileTag}" Focusable="False" IsTabStop="False"/>
                            <TextBlock Text="PING" Style="{StaticResource GS.Text.Caps}"/>
                        </DockPanel>
                        <ContentControl Content="{Binding Ping.Reading}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <!-- Scale in ms: the "High" band starts above 100 -->
                        <controls:Sparkline Buffer="{Binding Ping.History}" Height="28" Margin="0,6,0,0"
                                            Maximum="100" Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Perf.CpuGpu}" Margin="8,0,0,0"
                                            ContentTemplate="{StaticResource LiveTileTag}" Focusable="False" IsTabStop="False"/>
                            <TextBlock Text="CPU / GPU" Style="{StaticResource GS.Text.Caps}"/>
                        </DockPanel>
                        <ContentControl Content="{Binding Perf.CpuGpu}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource GS.Text.Caps}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <controls:Sparkline Grid.Row="0" Grid.Column="1" Buffer="{Binding Perf.CpuHistory}" Height="16"
                                                Stroke="{DynamicResource GS.Chart.Line}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Style="{StaticResource GS.Text.Caps}"
                                       VerticalAlignment="Center" Margin="0,2,6,0"
                                       Visibility="{Binding Perf.HasGpu, Converter={StaticResource BoolToVisibility}}"/>
                            <controls:Sparkline Grid.Row="1" Grid.Column="1" Buffer="{Binding Perf.GpuHistory}" Height="16"
                                                Margin="0,2,0,0" Stroke="{DynamicResource GS.Chart.Line}"
                                                Visibility="{Binding Perf.HasGpu, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Perf.Memory}" Margin="8,0,0,0"
                                            ContentTemplate="{StaticResource LiveTileTag}" Focusable="False" IsTabStop="False"/>
                            <TextBlock Text="MEMORY" Style="{StaticResource GS.Text.Caps}"/>
                        </DockPanel>
                        <ContentControl Content="{Binding Perf.Memory}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <controls:Sparkline Buffer="{Binding Perf.MemoryHistory}" Height="28" Margin="0,6,0,0"
                                            Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
            <TextBlock Text="{x:Static presentation:LiveTiles.Footnote}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource GS.Fg.Tertiary}" Margin="0,0,0,16"/>

            <!-- DPC Troubleshooter Results Panel, opened from the DPC spike notice. Full width above the
                 bottom panels: inside the narrow Notices card its summary and driver names would clip. -->
            <Border CornerRadius="4" Padding="15" Margin="0,0,0,12"
                    Background="{DynamicResource GS.Surface.Card}"
                    BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1"
                    Visibility="{Binding Dpc.ShowTroubleshooter, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <!-- Header row: title + summary + Re-scan button -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Re-scan" Padding="8,3"
                                Background="{DynamicResource GS.Surface.Base}"
                                Foreground="{DynamicResource GS.Text.Primary}"
                                BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1"
                                Cursor="Hand" FontSize="11"
                                IsEnabled="{Binding Dpc.CanRescan}"
                                Click="OnRescanDpcClicked"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DPC Troubleshooter" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource GS.Text.Primary}"/>
                            <TextBlock Text="{Binding Dpc.AnalysisSummary, Mode=OneWay}" FontSize="12"
                                       Foreground="{DynamicResource GS.Text.Secondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Analyzing state: indeterminate progress bar -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                                 Foreground="{DynamicResource GS.Interactive.Fill}"
                                 Background="{DynamicResource GS.Surface.Base}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dpc.IsAnalyzing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <!-- Results list: driver cards -->
                    <ItemsControl ItemsSource="{Binding Dpc.TroubleshooterResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource GS.Surface.Base}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,0,6"
                                        BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Driver header: filename + component name + severity badge -->
                                        <DockPanel Margin="0,0,0,4">
                                            <!-- Severity badge -->
                                            <Border DockPanel.Dock="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource GS.Badge.State}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Offender.Severity}" Value="High">
                                                                <Setter Property="Background" Value="{DynamicResource GS.Tint.Error}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Offender.Severity}" Value="Medium">
                                                                <Setter Property="Background" Value="{DynamicResource GS.Tint.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Offender.Severity}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Offender.Severity}" Value="High">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Offender.Severity}" Value="Medium">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DriverFileName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GS.Text.Primary}"/>
                                                    <TextBlock Text="{Binding FileVersion, StringFormat=' (v{0})'}" FontSize="11"
                                                               Foreground="{DynamicResource GS.Text.Secondary}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Offender.ComponentName}" FontSize="12"
                                                           Foreground="{DynamicResource GS.Text.Secondary}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Problem description -->
                                        <TextBlock Text="{Binding Offender.Problem}" FontSize="12"
                                                   Foreground="{DynamicResource GS.Text.Secondary}"
                                                   TextWrapping="Wrap" Margin="0,2,0,6"/>

                                        <!-- Fix steps as numbered list -->
                                        <ItemsControl ItemsSource="{Binding Offender.FixSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                        <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource GS.Fg.Secondary}"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding}" FontSize="12"
                                                                   Foreground="{DynamicResource GS.Text.Primary}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state (no offenders found, analysis complete) -->
                    <TextBlock FontSize="12" Foreground="{DynamicResource GS.Text.Secondary}"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Dpc.TroubleshooterResults.Count}" Value="0"/>
                                            <Condition Binding="{Binding Dpc.IsAnalyzing}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="No known DPC offenders detected. Your drivers look clean."/>
                        <LineBreak/>
                        <Run Text="If you still experience latency spikes, try updating all drivers to their latest versions."
                             Foreground="{DynamicResource GS.Text.Disabled}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Bottom: This session beside notices and recent sessions, stacked on a narrow window
                 (ShellLayout.HomeBottom); the page moves the three cards between the two columns. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BottomLeft" Grid.Column="0">

                    <!-- This session's changes: each module's own result, failed first, at most eight (HomeSessionList) -->
                    <Border x:Name="ThisSessionCard" Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Style="{StaticResource HomeCardHeader}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center">
                                        <Hyperlink Click="OnAllInDuringGamesClicked" Foreground="{DynamicResource GS.Fg.Link}">
                                            <Run Text="{Binding SessionLinkText, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SessionHeader}" Style="{StaticResource GS.Text.Caps}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding SessionModules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="36" Padding="14,6" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource GS.Line.Hairline}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Style="{StaticResource SessionRowIcon}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource GS.Fg.Primary}"/>
                                                    <TextBlock Text="{Binding StatusReason}" FontSize="12"
                                                               Foreground="{DynamicResource GS.Fg.Secondary}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasStatusReason, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding StateWord}" Style="{StaticResource SessionRowWord}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SessionMoreText}" FontSize="12" Margin="14,8"
                                       Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap"
                                       Visibility="{Binding HasSessionMore, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <StackPanel x:Name="BottomRight" Grid.Column="2">

                    <!-- Notices as rows. Each shows whenever its condition holds; on a narrow window two or more
                         fold into one row, so they do not push the rest of Home out of view. -->
                    <Border x:Name="NoticesCard" Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,16"
                            Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Style="{StaticResource HomeCardHeader}">
                                <TextBlock Text="NOTICES" Style="{StaticResource GS.Text.Caps}"/>
                            </Border>
                            <controls:NoticeBar Title="{Binding NoticeArea.SummaryText}" Severity="{Binding NoticeArea.SummarySeverity}"
                                                Visibility="{Binding NoticeArea.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{Binding NoticeToggleText}" HorizontalAlignment="Left" Click="OnToggleNoticesClicked"/>
                            </controls:NoticeBar>

                            <StackPanel Visibility="{Binding NoticeArea.ShowNotices, Converter={StaticResource BoolToVisibility}}">

                            <!-- Memory Integrity (VBS/HVCI): a warning while it costs performance, an error when it is off
                                 and an installed anti-cheat needs it -->
                            <controls:NoticeBar x:Name="VbsBanner" Message="{Binding Vbs.VbsBannerMessage, Mode=OneWay}"
                                                Visibility="{Binding Vbs.ShowVbsBanner, Converter={StaticResource BoolToVisibility}}">
                                <controls:NoticeBar.Style>
                                    <Style TargetType="controls:NoticeBar">
                                        <Setter Property="Title" Value="Performance Warning"/>
                                        <Setter Property="Severity" Value="Warning"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vbs.VbsBannerSeverity}" Value="error">
                                                <Setter Property="Title" Value="Anti-Cheat Conflict"/>
                                                <Setter Property="Severity" Value="Error"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:NoticeBar.Style>
                                <WrapPanel>
                                    <Button Margin="0,0,8,4" Click="OnDisableVbsClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Outline}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Vbs.IsVbsConflict}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Power20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Disable &amp; Reboot…" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,8,4" Click="OnReEnableVbsClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Outline}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Vbs.IsVbsConflict}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Power20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Re-enable &amp; Reboot…" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissVbsClicked"/>
                                </WrapPanel>
                            </controls:NoticeBar>

                            <!-- AMD platform-timer leftover: one-click revert and restart -->
                            <controls:NoticeBar Title="AMD Timer Setting" Severity="Warning"
                                                Message="{Binding AmdTimer.BannerMessage, Mode=OneWay}"
                                                Visibility="{Binding AmdTimer.ShowBanner, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel>
                                    <Button Style="{StaticResource GS.Button.Outline}" Margin="0,0,8,4" Click="OnFixAmdTimerClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Power20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Fix &amp; Restart…" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissAmdTimerClicked"/>
                                </WrapPanel>
                            </controls:NoticeBar>

                            <!-- DPC load spike -->
                            <controls:NoticeBar Title="High DPC Load" Severity="Error"
                                                Message="{Binding Dpc.DpcSpikeAlertMessage, Mode=OneWay}"
                                                Visibility="{Binding Dpc.ShowDpcSpikeAlert, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel>
                                    <Button Content="Troubleshoot" Style="{StaticResource GS.Button.Primary}" Margin="0,0,8,4"
                                            Click="OnTroubleshootDpcClicked"/>
                                    <Button Content="Open Latency Doctor" Margin="0,0,8,4" Click="OnOpenDpcDoctorClicked"/>
                                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissDpcSpikeClicked"/>
                                </WrapPanel>
                            </controls:NoticeBar>

                            <!-- Update: download, then restart into it. The status line replaces the version line while
                                 there is one, including why a download was refused; the release page is the way around. -->
                            <controls:NoticeBar Title="Update Available"
                                                Visibility="{Binding Update.ShowUpdateBanner, Converter={StaticResource BoolToVisibility}}">
                                <controls:NoticeBar.Style>
                                    <Style TargetType="controls:NoticeBar">
                                        <Setter Property="Message" Value="{Binding Update.DownloadStatusText, Mode=OneWay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Update.DownloadStatusText}" Value="">
                                                <Setter Property="Message" Value="{Binding Update.UpdateMessage, Mode=OneWay}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:NoticeBar.Style>
                                <WrapPanel>
                                    <Button Content="Download" Margin="0,0,8,4" Click="OnUpdateDownloadClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Primary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Downloading: the status line above carries the percentage -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ProgressBar Width="120" Height="16" Minimum="0" Maximum="100"
                                                     Value="{Binding Update.DownloadProgress, Mode=OneWay}"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource GS.Interactive.Fill}"
                                                     Background="{DynamicResource GS.Surface.Base}"/>
                                        <Button Content="Cancel" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnUpdateCancelClicked"/>
                                    </StackPanel>

                                    <Button Content="Restart Now" Margin="0,0,8,4" Click="OnUpdateRestartClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Primary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Release page" Margin="0,0,8,4" Click="OnUpdateReleasePageClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </controls:NoticeBar>

                            <!-- Lasting changes GameShift made, which stay after games close -->
                            <controls:NoticeBar Title="Lasting changes" Message="{Binding LastingChangesMessage}"
                                                Severity="{Binding LastingChangesSeverity}"
                                                Visibility="{Binding ShowLastingChangesNotice, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Review" HorizontalAlignment="Left" Click="OnReviewLastingChangesClicked"/>
                            </controls:NoticeBar>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- The last five sessions from the session history: game and length, then the result -->
                    <Border x:Name="RecentSessionsCard" Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Style="{StaticResource HomeCardHeader}">
                                <TextBlock Text="RECENT SESSIONS" Style="{StaticResource GS.Text.Caps}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding RecentSessions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource GS.Line.Hairline}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Length}"
                                                               Style="{StaticResource GS.Text.Numeric}" FontSize="12"
                                                               Foreground="{DynamicResource GS.Fg.Secondary}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Game}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Typography.NumeralAlignment="Tabular">
                                                    <Run Text="{Binding When, Mode=OneWay}"/><Run Text=" · "/><Run
                                                        Text="{Binding Counts, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No sessions yet. They appear here after a game closes."
                                       FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                                       TextWrapping="Wrap" Margin="14,10"
                                       Visibility="{Binding HasNoRecentSessions, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

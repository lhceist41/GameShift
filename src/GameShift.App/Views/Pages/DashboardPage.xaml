<Page x:Class="GameShift.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GameShift.App.Helpers"
      xmlns:controls="clr-namespace:GameShift.App.Views.Controls"
      xmlns:presentation="clr-namespace:GameShift.Core.Presentation;assembly=GameShift.Core"
      FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A live tile's value and the line under it. Raised and High carry an icon and a word, not only a colour. -->
        <DataTemplate x:Key="LiveTileReading" DataType="{x:Type presentation:TileReading}">
            <StackPanel Margin="0,4,0,0">
                <DockPanel>
                    <ui:SymbolIcon x:Name="ToneIcon" DockPanel.Dock="Left" Symbol="Warning16" FontSize="18"
                                   Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="TileValue" Text="{Binding Value}" Style="{StaticResource GS.Counter}"
                               TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="TileDetail" Text="{Binding Detail}" FontSize="12"
                           Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Detail}" Value="">
                    <Setter TargetName="TileDetail" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Raised">
                    <Setter TargetName="ToneIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ToneIcon" Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                    <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="High">
                    <Setter TargetName="ToneIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ToneIcon" Property="Symbol" Value="ErrorCircle16"/>
                    <Setter TargetName="ToneIcon" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                    <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Alert Banner Slide Animation (200ms, CubicEase) -->
        <Style x:Key="AnimatedBannerStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-30"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                    From="0" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-30" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status strip: the icon and headline colour follow HomeStatus kind and tone; the word always says it -->
        <Style x:Key="HomeStatusIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Symbol" Value="Circle16"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HomeStatus.Kind}" Value="Optimizing">
                    <Setter Property="Symbol" Value="Flash16"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HomeStatus.Kind}" Value="Paused">
                    <Setter Property="Symbol" Value="Pause16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HomeStatus.Tone}" Value="Active">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HomeStatus.Tone}" Value="Warning">
                    <Setter Property="Symbol" Value="Warning16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeHeadline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Primary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HomeStatus.Tone}" Value="Active">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HomeStatus.Tone}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Module badges, as on During games: colour follows the ModuleStatus kind -->
        <Style x:Key="ModuleBadge" TargetType="Border" BasedOn="{StaticResource GS.Badge.State}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Applied">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter Property="Background" Value="{DynamicResource GS.Tint.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModuleBadgeIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Symbol" Value="Circle16"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Applied">
                    <Setter Property="Symbol" Value="CheckmarkCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Symbol" Value="ErrorCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Off">
                    <Setter Property="Symbol" Value="SubtractCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Off}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="NotAvailable">
                    <Setter Property="Symbol" Value="DismissCircle16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Off}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter Property="Symbol" Value="Pause16"/>
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Off and Not available keep the Idle word colour: GS.State.Off is under 4.5:1 on the tint in Dark -->
        <Style x:Key="ModuleBadgeWord" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GS.State.Idle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Applied">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Active}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Paused}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  helpers:ScrollHelper.FixScrolling="True">
        <StackPanel Margin="24">

            <!-- Notices. Each shows whenever its condition holds; on a narrow window two or more fold
                 into one bar, so the status and the primary action below stay in view. -->
            <controls:NoticeBar Title="{Binding NoticeArea.SummaryText}" Severity="{Binding NoticeArea.SummarySeverity}"
                                Visibility="{Binding NoticeArea.ShowSummary, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{Binding NoticeToggleText}" HorizontalAlignment="Left" Click="OnToggleNoticesClicked"/>
            </controls:NoticeBar>

            <StackPanel Visibility="{Binding NoticeArea.ShowNotices, Converter={StaticResource BoolToVisibility}}">

            <!-- Memory Integrity (VBS/HVCI): a warning while it costs performance, an error when it is off
                 and an installed anti-cheat needs it -->
            <controls:NoticeBar x:Name="VbsBanner" Message="{Binding Vbs.VbsBannerMessage, Mode=OneWay}"
                                Visibility="{Binding Vbs.ShowVbsBanner, Converter={StaticResource BoolToVisibility}}">
                <controls:NoticeBar.Style>
                    <Style TargetType="controls:NoticeBar">
                        <Setter Property="Title" Value="Performance Warning"/>
                        <Setter Property="Severity" Value="Warning"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Vbs.VbsBannerSeverity}" Value="error">
                                <Setter Property="Title" Value="Anti-Cheat Conflict"/>
                                <Setter Property="Severity" Value="Error"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NoticeBar.Style>
                <WrapPanel>
                    <Button Content="Disable &amp; Reboot" Margin="0,0,8,4" Click="OnDisableVbsClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Restart}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vbs.IsVbsConflict}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Re-enable &amp; Reboot" Margin="0,0,8,4" Click="OnReEnableVbsClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Restart}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vbs.IsVbsConflict}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissVbsClicked"/>
                </WrapPanel>
            </controls:NoticeBar>

            <!-- AMD platform-timer leftover: one-click revert and restart -->
            <controls:NoticeBar Title="AMD Timer Setting" Severity="Warning"
                                Message="{Binding AmdTimer.BannerMessage, Mode=OneWay}"
                                Visibility="{Binding AmdTimer.ShowBanner, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel>
                    <Button Content="Fix &amp; Restart" Style="{StaticResource GS.Button.Restart}" Margin="0,0,8,4"
                            Click="OnFixAmdTimerClicked"/>
                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissAmdTimerClicked"/>
                </WrapPanel>
            </controls:NoticeBar>

            <!-- DPC load spike -->
            <controls:NoticeBar Title="High DPC Load" Severity="Error"
                                Message="{Binding Dpc.DpcSpikeAlertMessage, Mode=OneWay}"
                                Visibility="{Binding Dpc.ShowDpcSpikeAlert, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel>
                    <Button Content="Troubleshoot" Style="{StaticResource GS.Button.Primary}" Margin="0,0,8,4"
                            Click="OnTroubleshootDpcClicked"/>
                    <Button Content="Open Latency Doctor" Margin="0,0,8,4" Click="OnOpenDpcDoctorClicked"/>
                    <Button Content="Dismiss" Margin="0,0,8,4" Click="OnDismissDpcSpikeClicked"/>
                </WrapPanel>
            </controls:NoticeBar>

            <!-- DPC Troubleshooter Results Panel (inline, below spike banner) -->
            <Border CornerRadius="8" Padding="15" Margin="0,0,0,12"
                    Background="{DynamicResource GS.Surface.Card}"
                    BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1"
                    Visibility="{Binding Dpc.ShowTroubleshooter, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource AnimatedBannerStyle}">
                <StackPanel>
                    <!-- Header row: title + summary + Re-scan button -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Re-scan" Padding="8,3"
                                Background="{DynamicResource GS.Surface.Base}"
                                Foreground="{DynamicResource GS.Text.Primary}"
                                BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1"
                                Cursor="Hand" FontSize="11"
                                IsEnabled="{Binding Dpc.CanRescan}"
                                Click="OnRescanDpcClicked"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DPC Troubleshooter" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource GS.Text.Primary}"/>
                            <TextBlock Text="{Binding Dpc.AnalysisSummary, Mode=OneWay}" FontSize="12"
                                       Foreground="{DynamicResource GS.Text.Secondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Analyzing state: indeterminate progress bar -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                                 Foreground="{DynamicResource GS.Accent.Primary}"
                                 Background="{DynamicResource GS.Surface.Base}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dpc.IsAnalyzing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <!-- Results list: driver cards -->
                    <ItemsControl ItemsSource="{Binding Dpc.TroubleshooterResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource GS.Surface.Base}"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,6"
                                        BorderBrush="{DynamicResource GS.Surface.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Driver header: filename + component name + severity badge -->
                                        <DockPanel Margin="0,0,0,4">
                                            <!-- Severity badge -->
                                            <Border DockPanel.Dock="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource GS.Badge.State}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Offender.Severity}" Value="High">
                                                                <Setter Property="Background" Value="{DynamicResource GS.Tint.Error}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Offender.Severity}" Value="Medium">
                                                                <Setter Property="Background" Value="{DynamicResource GS.Tint.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Offender.Severity}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Secondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Offender.Severity}" Value="High">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Offender.Severity}" Value="Medium">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DriverFileName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GS.Text.Primary}"/>
                                                    <TextBlock Text="{Binding FileVersion, StringFormat=' (v{0})'}" FontSize="11"
                                                               Foreground="{DynamicResource GS.Text.Secondary}"
                                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Offender.ComponentName}" FontSize="12"
                                                           Foreground="{DynamicResource GS.Text.Secondary}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Problem description -->
                                        <TextBlock Text="{Binding Offender.Problem}" FontSize="12"
                                                   Foreground="{DynamicResource GS.Text.Secondary}"
                                                   TextWrapping="Wrap" Margin="0,2,0,6"/>

                                        <!-- Fix steps as numbered list -->
                                        <ItemsControl ItemsSource="{Binding Offender.FixSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                        <TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource GS.Accent.Primary}"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding}" FontSize="12"
                                                                   Foreground="{DynamicResource GS.Text.Primary}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state (no offenders found, analysis complete) -->
                    <TextBlock FontSize="12" Foreground="{DynamicResource GS.Text.Secondary}"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Dpc.TroubleshooterResults.Count}" Value="0"/>
                                            <Condition Binding="{Binding Dpc.IsAnalyzing}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="No known DPC offenders detected. Your drivers look clean."/>
                        <LineBreak/>
                        <Run Text="If you still experience latency spikes, try updating all drivers to their latest versions."
                             Foreground="{DynamicResource GS.Text.Disabled}"/>
                    </TextBlock>
                </StackPanel>
            </Border>


            <!-- Update: download, then restart into it. The status line replaces the version line while
                 there is one, including why a download was refused; the release page is the way around. -->
            <controls:NoticeBar Title="Update Available"
                                Visibility="{Binding Update.ShowUpdateBanner, Converter={StaticResource BoolToVisibility}}">
                <controls:NoticeBar.Style>
                    <Style TargetType="controls:NoticeBar">
                        <Setter Property="Message" Value="{Binding Update.DownloadStatusText, Mode=OneWay}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Update.DownloadStatusText}" Value="">
                                <Setter Property="Message" Value="{Binding Update.UpdateMessage, Mode=OneWay}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NoticeBar.Style>
                <WrapPanel>
                    <Button Content="Download" Margin="0,0,8,4" Click="OnUpdateDownloadClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Downloading: the status line above carries the percentage -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Width="120" Height="16" Minimum="0" Maximum="100"
                                     Value="{Binding Update.DownloadProgress, Mode=OneWay}"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource GS.Accent.Primary}"
                                     Background="{DynamicResource GS.Surface.Base}"/>
                        <Button Content="Cancel" Margin="8,0,0,0" VerticalAlignment="Center"
                                Click="OnUpdateCancelClicked"/>
                    </StackPanel>

                    <Button Content="Restart Now" Margin="0,0,8,4" Click="OnUpdateRestartClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GS.Button.Primary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Release page" Margin="0,0,8,4" Click="OnUpdateReleasePageClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Update.IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Update.IsUpdateReady}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </controls:NoticeBar>

            <!-- Lasting changes GameShift made, which stay after games close -->
            <controls:NoticeBar Title="Lasting changes" Message="{Binding LastingChangesMessage}"
                                Severity="{Binding LastingChangesSeverity}"
                                Visibility="{Binding ShowLastingChangesNotice, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Review" HorizontalAlignment="Left" Click="OnReviewLastingChangesClicked"/>
            </controls:NoticeBar>

            </StackPanel> <!-- End notices -->

            <!-- Status strip: what GameShift did in the session running now (HomeSnapshot) -->
            <Border Style="{StaticResource GS.Panel}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource HomeStatusIcon}"/>
                            <TextBlock Text="{Binding HomeStatus.Headline}" Style="{StaticResource HomeHeadline}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding HomeStatus.CountsLine}"
                                   Style="{StaticResource GS.Text.Numeric}" FontSize="13"
                                   Foreground="{DynamicResource GS.Fg.Secondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasCountsLine, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- What Quick Optimize applies: a link that opens the list -->
                        <TextBlock x:Name="OptimizationPreviewLink"
                                   Text="{Binding Hero.HeroPreviewText}"
                                   FontSize="12" Cursor="Hand" TextWrapping="Wrap"
                                   Foreground="{DynamicResource GS.Fg.Link}"
                                   Margin="0,8,0,0"
                                   MouseLeftButtonUp="OnOptimizationPreviewClicked"
                                   Visibility="{Binding Hero.ShowHeroPreview, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.TextDecorations>
                                <TextDecorationCollection>
                                    <TextDecoration Location="Underline"/>
                                </TextDecorationCollection>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                        <ItemsControl x:Name="PreviewList"
                                      ItemsSource="{Binding Hero.HeroPreviewItems}"
                                      Margin="0,6,0,0" Focusable="False"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource GS.Fg.Secondary}"
                                               Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Busy: disabled, and the text says what it is doing -->
                    <Button Grid.Column="1"
                            Command="{Binding Hero.OptimizeNowCommand}"
                            IsEnabled="{Binding Hero.CanPressButton}"
                            VerticalAlignment="Center" MinWidth="140"
                            Style="{StaticResource GS.Button.Primary}">
                        <TextBlock Text="{Binding Hero.HeroButtonText}" TextWrapping="Wrap"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Live tiles: only what GameShift measures; a source it cannot read says so (LiveTiles).
                 The feed stops while Home is not seen (HomeFeedGate). -->
            <TextBlock Text="LIVE READINGS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,4"/>
            <UniformGrid x:Name="LiveTilePanel" Columns="4" Margin="-4,0,-4,20" SizeChanged="OnLiveTilesSizeChanged">

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="DPC LOAD" Style="{StaticResource GS.Text.Caps}"
                                   ToolTip="Share of CPU time drivers spend on deferred procedure calls (DPC). Lower is better."/>
                        <ContentControl Content="{Binding Dpc.Reading}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <controls:Sparkline Buffer="{Binding Dpc.History}" Height="32" Margin="0,8,0,0"
                                            Maximum="{x:Static presentation:LiveTiles.DpcHighAbove}"
                                            Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="PING" Style="{StaticResource GS.Text.Caps}"/>
                        <ContentControl Content="{Binding Ping.Reading}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <!-- Scale in ms: the "High" band starts above 100 -->
                        <controls:Sparkline Buffer="{Binding Ping.History}" Height="32" Margin="0,8,0,0"
                                            Maximum="100" Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CPU / GPU" Style="{StaticResource GS.Text.Caps}"/>
                        <ContentControl Content="{Binding Perf.CpuGpu}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource GS.Text.Caps}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <controls:Sparkline Grid.Row="0" Grid.Column="1" Buffer="{Binding Perf.CpuHistory}" Height="16"
                                                Stroke="{DynamicResource GS.Chart.Line}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Style="{StaticResource GS.Text.Caps}"
                                       VerticalAlignment="Center" Margin="0,2,6,0"
                                       Visibility="{Binding Perf.HasGpu, Converter={StaticResource BoolToVisibility}}"/>
                            <controls:Sparkline Grid.Row="1" Grid.Column="1" Buffer="{Binding Perf.GpuHistory}" Height="16"
                                                Margin="0,2,0,0" Stroke="{DynamicResource GS.Chart.Line}"
                                                Visibility="{Binding Perf.HasGpu, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GS.Tile.Metric}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource GS.Text.Caps}"/>
                        <ContentControl Content="{Binding Perf.Memory}" ContentTemplate="{StaticResource LiveTileReading}"
                                        Focusable="False" IsTabStop="False"/>
                        <controls:Sparkline Buffer="{Binding Perf.MemoryHistory}" Height="32" Margin="0,8,0,0"
                                            Stroke="{DynamicResource GS.Chart.Line}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- This session's changes: each module's own result, failed first (HomeSnapshot) -->
            <TextBlock Text="THIS SESSION" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding SessionModules}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GS.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusReason}" FontSize="12"
                                                   Foreground="{DynamicResource GS.Fg.Secondary}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasStatusReason, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ModuleBadge}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Style="{StaticResource ModuleBadgeIcon}"/>
                                            <TextBlock Text="{Binding StatusWord}" Style="{StaticResource ModuleBadgeWord}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The last five sessions from the session history -->
            <TextBlock Text="RECENT SESSIONS" Style="{StaticResource GS.Text.Caps}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource GS.Panel}" Padding="0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentSessions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GS.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Game}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Counts}" FontSize="12"
                                                       Foreground="{DynamicResource GS.Fg.Secondary}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding When}" Style="{StaticResource GS.Text.Numeric}"
                                                       FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                                                       HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Length}" Style="{StaticResource GS.Text.Numeric}"
                                                       FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                                                       HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No sessions yet. They appear here after a game closes."
                               FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                               TextWrapping="Wrap" Margin="12,12"
                               Visibility="{Binding HasNoRecentSessions, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

<Window x:Class="GameShift.App.Views.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameShift Setup" Width="520" MinHeight="490" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource GS.Fill.Window}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step 1: Welcome -->
        <Grid x:Name="Step1Panel" Grid.Row="0" Visibility="Visible" Margin="48,40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- App name hero -->
                <TextBlock Text="GameShift"
                           FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource GS.Fg.Primary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <!-- Version badge -->
                <TextBlock x:Name="VersionBadge"
                           Text="v3.0"
                           FontSize="14"
                           Foreground="{DynamicResource GS.Fg.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Description -->
                <TextBlock Text="System optimizer for competitive gaming."
                           FontSize="16"
                           Foreground="{DynamicResource GS.Fg.Primary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,40"/>

                <!-- Step indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GS.Interactive.Fill}" Margin="4,0"/>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GS.Line.Strong}" Margin="4,0"/>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GS.Line.Strong}" Margin="4,0"/>
                </StackPanel>

                <!-- Get Started button -->
                <Button x:Name="GetStartedButton"
                        Content="Get Started"
                        Style="{StaticResource GS.Button.Primary}"
                        MinWidth="160" MinHeight="40"
                        FontSize="14"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="OnGetStartedClicked"/>
            </StackPanel>
        </Grid>

        <!-- Step 2: Game Library Scan -->
        <Grid x:Name="Step2Panel" Grid.Row="0" Visibility="Collapsed" Margin="48,40">
            <StackPanel VerticalAlignment="Top">
                <!-- Header -->
                <TextBlock Text="Scan Game Libraries"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource GS.Fg.Primary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="{DynamicResource GS.Line.Hairline}" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="GameShift will scan Steam, Epic Games, and GOG Galaxy for installed games."
                           FontSize="14"
                           Foreground="{DynamicResource GS.Fg.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <!-- Scan card -->
                <Border Style="{StaticResource GS.Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Libraries:" FontSize="13" Foreground="{DynamicResource GS.Fg.Secondary}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="Steam, Epic Games, GOG Galaxy" FontSize="13"
                                       Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Games count result -->
                        <TextBlock x:Name="GamesCountText"
                                   Text=""
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GS.State.Active}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"/>

                        <!-- Scan button -->
                        <Button x:Name="ScanNowButton"
                                Content="Scan Now"
                                MinWidth="120" MinHeight="36"
                                FontSize="13"
                                HorizontalAlignment="Left"
                                Click="OnScanClicked"/>
                    </StackPanel>
                </Border>

                <!-- Skip note -->
                <TextBlock Text="You can re-scan at any time from the Game Library page."
                           FontSize="12"
                           Foreground="{DynamicResource GS.Fg.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Step 3: Quick Config -->
        <Grid x:Name="Step3Panel" Grid.Row="0" Visibility="Collapsed" Margin="48,40">
            <StackPanel VerticalAlignment="Top">
                <!-- Header -->
                <TextBlock Text="Quick Configuration"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource GS.Fg.Primary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="{DynamicResource GS.Line.Hairline}" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="Set your preferences. These can be changed later in Settings."
                           FontSize="14"
                           Foreground="{DynamicResource GS.Fg.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                <!-- Settings card -->
                <Border Style="{StaticResource GS.Panel}" Padding="20">
                    <StackPanel>
                        <!-- Start with Windows -->
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      DockPanel.Dock="Right"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      IsChecked="True"/>
                            <StackPanel>
                                <TextBlock Text="Start with Windows"
                                           FontSize="14"
                                           Foreground="{DynamicResource GS.Fg.Primary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Launch GameShift when Windows starts"
                                           FontSize="12"
                                           Foreground="{DynamicResource GS.Fg.Secondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="{DynamicResource GS.Line.Hairline}" Margin="0,0,0,16"/>

                        <!-- Enable notifications -->
                        <DockPanel>
                            <CheckBox x:Name="NotificationsCheckBox"
                                      DockPanel.Dock="Right"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      IsChecked="True"/>
                            <StackPanel>
                                <TextBlock Text="Enable Notifications"
                                           FontSize="14"
                                           Foreground="{DynamicResource GS.Fg.Primary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Show session summary and alerts"
                                           FontSize="12"
                                           Foreground="{DynamicResource GS.Fg.Secondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom navigation bar -->
        <Border Grid.Row="1" Background="{DynamicResource GS.Fill.Pane}" BorderBrush="{DynamicResource GS.Line.Hairline}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <!-- Step indicator dots -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{DynamicResource GS.Interactive.Fill}" Margin="4,0"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{DynamicResource GS.Line.Strong}" Margin="4,0"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="{DynamicResource GS.Line.Strong}" Margin="4,0"/>
                </StackPanel>

                <!-- Navigation buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <!-- Skip/Back button (hidden on step 1) -->
                    <Button x:Name="SkipButton"
                            Content="Skip"
                            MinWidth="80" MinHeight="32"
                            FontSize="13"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="OnSkipClicked"/>

                    <!-- Next/Finish button (hidden on step 1 - step 1 uses Get Started in panel) -->
                    <Button x:Name="NextButton"
                            Content="Next"
                            Style="{StaticResource GS.Button.Primary}"
                            MinWidth="100" MinHeight="32"
                            FontSize="13"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="OnNextClicked"/>

                    <!-- Finish button (shown only on step 3) -->
                    <Button x:Name="FinishButton"
                            Content="Finish"
                            Style="{StaticResource GS.Button.Primary}"
                            MinWidth="100" MinHeight="32"
                            FontSize="13"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="OnFinishClicked"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

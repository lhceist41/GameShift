<ui:FluentWindow x:Class="GameShift.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:GameShift.App.Views.Pages"
    Title="GameShift"
    Icon="pack://application:,,,/Resources/gameshift.ico"
    Width="900" Height="620" MinWidth="780" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource GS.Fill.Window}"
    FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Minimize and close keep going through OnStateChanged and OnClosing, which hide to the tray. -->
        <ui:TitleBar Grid.Row="0" Title="GameShift">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/gameshift.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="NavigationView"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            PaneDisplayMode="LeftMinimal"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="240"
            Transition="FadeInWithSlide"
            TransitionDuration="150">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavHome" Content="Home" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- In the icon rail the group headers would be cut off, so each group gets a separator instead -->
                <ui:NavigationViewItemHeader x:Name="NavHeaderGames" Text="Games"/>
                <ui:NavigationViewItemSeparator x:Name="NavSeparatorGames" Visibility="Collapsed"/>
                <ui:NavigationViewItem x:Name="NavLibrary" Content="Library" TargetPageType="{x:Type pages:GameLibraryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Library24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavProfiles" Content="Profiles" TargetPageType="{x:Type pages:ProfilesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Games24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader x:Name="NavHeaderOptimize" Text="Optimize"/>
                <ui:NavigationViewItemSeparator x:Name="NavSeparatorOptimize" Visibility="Collapsed"/>
                <ui:NavigationViewItem x:Name="NavDuringGames" Content="During games" TargetPageType="{x:Type pages:DuringGamesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Rocket24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavLastingChanges" Content="Lasting changes" TargetPageType="{x:Type pages:LastingChangesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Wrench24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavLatencyDoctor" Content="Latency Doctor" TargetPageType="{x:Type pages:DpcDoctorPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="HeartPulse24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader x:Name="NavHeaderInfo" Text="Info"/>
                <ui:NavigationViewItemSeparator x:Name="NavSeparatorInfo" Visibility="Collapsed"/>
                <ui:NavigationViewItem x:Name="NavSystem" Content="System" TargetPageType="{x:Type pages:SystemPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Desktop24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavActivity" Content="Activity" TargetPageType="{x:Type pages:ActivityLogPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Document24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings" Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.PaneFooter>
                <TextBlock x:Name="VersionLabel"
                           FontSize="11" Foreground="{DynamicResource GS.Fg.Tertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,8"/>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.ContentOverlay>
                <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Startup loading overlay. Covers everything below the title bar (including the nav pane, so a
             page cannot be opened before its services exist) while core services are built
             on a background thread. Removed by App.OnStartup via HideLoadingOverlay() once
             the dashboard is ready. -->
        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{DynamicResource GS.Fill.Window}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="54" Height="54"
                                 Foreground="{DynamicResource GS.Interactive.Fill}"
                                 HorizontalAlignment="Center"/>
                <TextBlock Text="Starting GameShift..."
                           Foreground="{DynamicResource GS.Fg.Primary}" FontSize="15" FontWeight="SemiBold"
                           Margin="0,18,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Preparing optimizations"
                           Foreground="{DynamicResource GS.Fg.Secondary}" FontSize="12"
                           Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Host for WPF-UI ContentDialogs (the restart confirm); last and across both rows, so a dialog
             covers the whole window, title bar included. -->
        <ContentPresenter x:Name="DialogHostPresenter" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</ui:FluentWindow>

<ContentControl x:Class="GameShift.App.Views.Controls.NoticeBar"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:controls="clr-namespace:GameShift.App.Views.Controls"
                Focusable="False">
    <!-- A compact notice row for Home's Notices card, with room for action buttons: WPF-UI's InfoBar
         has no action slot and its severity colours do not follow the GameShift theme tokens. The
         buttons are this control's content. The severity shows as the icon's shape and colour. -->
    <ContentControl.Template>
        <ControlTemplate TargetType="controls:NoticeBar">
            <Border x:Name="Chrome" Padding="14,9" BorderThickness="0,0,0,1" Background="Transparent"
                    BorderBrush="{DynamicResource GS.Line.Hairline}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon x:Name="Glyph" Symbol="Info16" FontSize="14" Margin="0,2,10,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageText" Text="{TemplateBinding Message}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource GS.Fg.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ContentPresenter x:Name="Actions" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Severity" Value="Warning">
                    <Setter TargetName="Glyph" Property="Symbol" Value="Warning16"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </Trigger>
                <Trigger Property="Severity" Value="Error">
                    <Setter TargetName="Glyph" Property="Symbol" Value="ErrorCircle16"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </Trigger>
                <Trigger Property="Message" Value="">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Message" Value="{x:Null}">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>

<ContentControl x:Class="GameShift.App.Views.Controls.NoticeBar"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:controls="clr-namespace:GameShift.App.Views.Controls"
                Margin="0,0,0,12" Focusable="False">
    <!-- An InfoBar with room for action buttons: WPF-UI's InfoBar has no action slot and its severity
         colours do not follow the GameShift theme tokens. The buttons are this control's content. -->
    <ContentControl.Template>
        <ControlTemplate TargetType="controls:NoticeBar">
            <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" Padding="16,12" MinHeight="48"
                    Background="{DynamicResource GS.Fill.Card}" BorderBrush="{DynamicResource GS.Line.Strong}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon x:Name="Glyph" Symbol="Info24" FontSize="16" Margin="0,1,12,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource GS.Fg.Secondary}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageText" Text="{TemplateBinding Message}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ContentPresenter x:Name="Actions" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Severity" Value="Warning">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GS.Tint.Warning}"/>
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GS.State.Warning}"/>
                    <Setter TargetName="Glyph" Property="Symbol" Value="Warning24"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GS.State.Warning}"/>
                </Trigger>
                <Trigger Property="Severity" Value="Error">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GS.Tint.Error}"/>
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GS.State.Error}"/>
                    <Setter TargetName="Glyph" Property="Symbol" Value="ErrorCircle24"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GS.State.Error}"/>
                </Trigger>
                <Trigger Property="Message" Value="">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Message" Value="{x:Null}">
                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>

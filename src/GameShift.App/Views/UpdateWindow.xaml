<Window x:Class="GameShift.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameShift Update" Width="580" MinHeight="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource GS.Fill.Window}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Grid Margin="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Update Available"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource GS.Fg.Primary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="VersionText"
                       FontSize="14"
                       Foreground="{DynamicResource GS.Fg.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>
            <Rectangle Height="1" Fill="{DynamicResource GS.Line.Hairline}" Margin="0,10,0,0"/>

            <!-- Urgent update banner (shown for critical fixes) -->
            <Border x:Name="UrgentBanner" Visibility="Collapsed"
                    Background="{DynamicResource GS.Tint.Error}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource GS.State.Error}" BorderThickness="1">
                <TextBlock x:Name="UrgentBannerText"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource GS.Fg.Primary}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Row 1: Content area -->
        <Grid Grid.Row="1">
            <!-- Release notes (Initial state) -->
            <StackPanel x:Name="NotesPanel" Visibility="Visible">
                <TextBlock Text="What's new:"
                           FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                           Margin="0,0,0,8"/>
                <Border Background="{DynamicResource GS.Fill.Card}" CornerRadius="8"
                        BorderBrush="{DynamicResource GS.Line.Hairline}" BorderThickness="1"
                        Padding="16,14,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="240"
                                  Padding="0,0,12,0">
                        <TextBlock x:Name="ReleaseNotesText"
                                   FontSize="13" LineHeight="20"
                                   Foreground="{DynamicResource GS.Fg.Primary}"
                                   TextWrapping="Wrap"
                                   Text="Loading release notes..."/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Download progress (Downloading state) -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DownloadStatusText"
                           FontSize="14" Foreground="{DynamicResource GS.Fg.Primary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Text="Downloading update..."/>
                <ProgressBar x:Name="DownloadProgress"
                             Height="6"
                             Minimum="0" Maximum="100"
                             Value="0"
                             Background="{DynamicResource GS.Fill.CardSecondary}"
                             Foreground="{DynamicResource GS.Interactive.Fill}"
                             BorderThickness="0"
                             Margin="0,0,0,10"/>
                <TextBlock x:Name="ProgressPercentText"
                           FontSize="12" Foreground="{DynamicResource GS.Fg.Secondary}"
                           HorizontalAlignment="Center"
                           Text="0%"/>
            </StackPanel>

            <!-- Error state -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ErrorText"
                           FontSize="14" Foreground="{DynamicResource GS.State.Error}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16"
                           Text="Download failed. Please try again."/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Button bar -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <!-- Initial state buttons -->
            <StackPanel x:Name="InitialButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RemindLaterButton"
                        Content="Remind Me Later"
                        MinHeight="36" Margin="0,0,10,0"
                        FontSize="13"
                        Click="OnRemindLaterClicked"/>

                <Button x:Name="SkipVersionButton"
                        Content="Skip This Version"
                        MinHeight="36" Margin="0,0,10,0"
                        FontSize="13"
                        Click="OnSkipClicked"/>

                <Button x:Name="DownloadButton"
                        Content="Download &amp; Install"
                        MinHeight="36"
                        FontSize="13"
                        Cursor="Hand"
                        Style="{StaticResource GS.Button.Primary}"
                        Click="OnDownloadClicked"/>
            </StackPanel>

            <!-- Downloading state buttons -->
            <StackPanel x:Name="DownloadingButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinHeight="36"
                        FontSize="13"
                        Click="OnCancelClicked"/>
            </StackPanel>

            <!-- Ready state buttons -->
            <StackPanel x:Name="ReadyButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button x:Name="LaterButton"
                        Content="Later"
                        MinHeight="36" Margin="0,0,10,0"
                        FontSize="13"
                        Click="OnRemindLaterClicked"/>

                <Button x:Name="InstallButton"
                        Content="Install &amp; Restart"
                        MinHeight="36"
                        FontSize="13"
                        Cursor="Hand"
                        Style="{StaticResource GS.Button.Primary}"
                        Click="OnInstallClicked"/>
            </StackPanel>

            <!-- Error state buttons -->
            <StackPanel x:Name="ErrorButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button x:Name="DismissButton"
                        Content="Close"
                        MinHeight="36" Margin="0,0,10,0"
                        FontSize="13"
                        Click="OnRemindLaterClicked"/>

                <Button x:Name="RetryButton"
                        Content="Try Again"
                        MinHeight="36"
                        FontSize="13"
                        Cursor="Hand"
                        Style="{StaticResource GS.Button.Primary}"
                        Click="OnDownloadClicked"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Alias layer: the keys pages used before the theme tokens existed, each pointing at a token
         of the active theme (Themes/GameShift.*.xaml). StaticResource resolves when this file loads,
         so the theme service reloads it after every token swap; pages keep their DynamicResource uses.
         ============================================================ -->

    <!-- Surfaces -->
    <StaticResource x:Key="GS.Surface.Base" ResourceKey="GS.Fill.Window" />
    <StaticResource x:Key="GS.Surface.Card" ResourceKey="GS.Fill.Card" />
    <StaticResource x:Key="GS.Surface.Elevated" ResourceKey="GS.Fill.CardSecondary" />
    <StaticResource x:Key="GS.Surface.Border" ResourceKey="GS.Line.Hairline" />

    <!-- Text -->
    <StaticResource x:Key="GS.Text.Primary" ResourceKey="GS.Fg.Primary" />
    <StaticResource x:Key="GS.Text.Secondary" ResourceKey="GS.Fg.Secondary" />
    <StaticResource x:Key="GS.Text.Disabled" ResourceKey="GS.Fg.Tertiary" />

    <!-- Status. The design has no info state, and colour is reserved for state. -->
    <StaticResource x:Key="GS.Status.Active" ResourceKey="GS.State.Active" />
    <StaticResource x:Key="GS.Status.Warning" ResourceKey="GS.State.Warning" />
    <StaticResource x:Key="GS.Status.Error" ResourceKey="GS.State.Error" />
    <StaticResource x:Key="GS.Status.Info" ResourceKey="GS.Fg.Secondary" />
    <StaticResource x:Key="GS.Status.Disabled" ResourceKey="GS.State.Off" />

    <!-- Badge backgrounds -->
    <StaticResource x:Key="GS.Badge.Active.Bg" ResourceKey="GS.Tint.Active" />
    <StaticResource x:Key="GS.Badge.Warning.Bg" ResourceKey="GS.Tint.Warning" />
    <StaticResource x:Key="GS.Badge.Error.Bg" ResourceKey="GS.Tint.Error" />

    <!-- Accent. Pages still use it for buttons and status text alike until they are restyled;
         the brand colour keeps both readable where the neutral fill would not be. -->
    <StaticResource x:Key="GS.Accent.Primary" ResourceKey="GS.State.Active" />
    <StaticResource x:Key="GS.Accent.Hover" ResourceKey="GS.Interactive.FillHover" />

    <!-- ============================================================
         Typography Styles
         Apply with: Style="{DynamicResource GS.Text.Hero}"
         ============================================================ -->
    <Style x:Key="GS.Text.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="32" />
        <Setter Property="FontWeight"  Value="Bold" />
        <Setter Property="Foreground"  Value="{DynamicResource GS.Fg.Primary}" />
    </Style>

    <Style x:Key="GS.Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="15" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{DynamicResource GS.Fg.Primary}" />
    </Style>

    <Style x:Key="GS.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="13" />
        <Setter Property="FontWeight"  Value="Normal" />
        <Setter Property="Foreground"  Value="{DynamicResource GS.Fg.Primary}" />
    </Style>

    <!-- ============================================================
         Hero Button Style
         Large call-to-action button for one-click optimize, now the neutral primary look.
         ============================================================ -->
    <Style x:Key="GS.Button.Hero" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource GS.Interactive.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource GS.Interactive.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="24,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GS.Interactive.FillHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource GS.Fill.CardSecondary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GS.Fg.Tertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

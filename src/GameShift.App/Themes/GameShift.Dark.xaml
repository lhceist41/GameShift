<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme tokens. The three theme files define the same keys; only these files hold colour values. -->

    <Color x:Key="GS.Color.Interactive">#E8EDF2</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="GS.Fill.Window" Color="#0B0D10" />
    <SolidColorBrush x:Key="GS.Fill.Pane" Color="#0F1216" />
    <SolidColorBrush x:Key="GS.Fill.PaneEdge" Color="#1A1F26" />
    <SolidColorBrush x:Key="GS.Fill.Card" Color="#13171C" />
    <SolidColorBrush x:Key="GS.Fill.CardSecondary" Color="#1A1F26" />
    <SolidColorBrush x:Key="GS.Fill.Input" Color="#0F1216" />

    <!-- Lines. Hairlines are decoration; control borders mark component boundaries and need 3:1. -->
    <SolidColorBrush x:Key="GS.Line.Hairline" Color="#262D36" />
    <SolidColorBrush x:Key="GS.Line.Strong" Color="#36404B" />
    <SolidColorBrush x:Key="GS.Line.Control" Color="#7E8A97" />
    <SolidColorBrush x:Key="GS.Line.Badge" Color="Transparent" />

    <!-- Text -->
    <SolidColorBrush x:Key="GS.Fg.Primary" Color="#E8EDF2" />
    <SolidColorBrush x:Key="GS.Fg.Secondary" Color="#9AA6B2" />
    <SolidColorBrush x:Key="GS.Fg.Tertiary" Color="#7E8A97" />
    <SolidColorBrush x:Key="GS.Fg.Link" Color="#E8EDF2" />

    <!-- Interactive elements are neutral: colour is reserved for state -->
    <SolidColorBrush x:Key="GS.Interactive.Fill" Color="{StaticResource GS.Color.Interactive}" />
    <SolidColorBrush x:Key="GS.Interactive.FillHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GS.Interactive.FillPressed" Color="#C5CED7" />
    <SolidColorBrush x:Key="GS.Interactive.Text" Color="#0B0D10" />
    <SolidColorBrush x:Key="GS.Nav.Selected" Color="#1A1F26" />
    <SolidColorBrush x:Key="GS.Nav.Indicator" Color="#E8EDF2" />
    <SolidColorBrush x:Key="GS.Focus" Color="#E8EDF2" />

    <!-- States -->
    <SolidColorBrush x:Key="GS.State.Active" Color="#2ED3F0" />
    <SolidColorBrush x:Key="GS.State.Warning" Color="#FFB547" />
    <SolidColorBrush x:Key="GS.State.Error" Color="#FF6B6B" />
    <SolidColorBrush x:Key="GS.State.Paused" Color="#B69CFF" />
    <SolidColorBrush x:Key="GS.State.Idle" Color="#9AA6B2" />
    <SolidColorBrush x:Key="GS.State.Off" Color="#7E8A97" />

    <!-- Badge tints: the state colour at 14% over the card, flattened so contrast can be computed -->
    <SolidColorBrush x:Key="GS.Tint.Active" Color="#17313A" />
    <SolidColorBrush x:Key="GS.Tint.Warning" Color="#342D22" />
    <SolidColorBrush x:Key="GS.Tint.Error" Color="#342327" />
    <SolidColorBrush x:Key="GS.Tint.Paused" Color="#2A2A3C" />
    <SolidColorBrush x:Key="GS.Tint.Idle" Color="#262B31" />

    <!-- Charts and the icon tile -->
    <SolidColorBrush x:Key="GS.Chart.Line" Color="#9AA6B2" />
    <SolidColorBrush x:Key="GS.Chart.Grid" Color="#262D36" />
    <SolidColorBrush x:Key="GS.Icon.Tile" Color="#13171C" />
    <SolidColorBrush x:Key="GS.Icon.Glyph" Color="#2ED3F0" />

</ResourceDictionary>
